# انسخ هالملف باسم .env.local وحط فيه القيم الحقيقية (ما يُرفع لـGit).

# Neon Postgres — connection string كامل (من Neon Console → Connection Details)
DATABASE_URL=

# Neon Auth (Managed Better Auth) — من Neon Console → Auth
NEON_AUTH_BASE_URL=
# سرّ لتوقيع كوكي الجلسة — ولّده بأمر: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEON_AUTH_COOKIE_SECRET=
